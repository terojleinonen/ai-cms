# Copy to .env for `docker compose up`
POSTGRES_PASSWORD=change-me
# Shared secret between the Next.js server and the API (use a long random value)
ADMIN_API_KEY=change-me-too
# Password for the admin UI (HTTP Basic auth)
ADMIN_PASSWORD=change-me-as-well
# Optional: without a key the app falls back to a basic offline AI provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
